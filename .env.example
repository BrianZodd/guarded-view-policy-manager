# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). The publishable key is safe to use in the browser,
# row level security is what keeps each user's data private.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
